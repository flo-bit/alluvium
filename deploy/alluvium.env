ALLUVIUM_ADDR=127.0.0.1:8090
ALLUVIUM_DATA_DIR=/var/lib/alluvium/store
ALLUVIUM_JETSTREAM=http://127.0.0.1:8080
# Uncomment to require a token for exports ("name token" per line).
#ALLUVIUM_TOKENS_FILE=/etc/alluvium/tokens
GOMEMLIMIT=700MiB

# discover
ALLUVIUM_REPO_LIST=/var/lib/alluvium/repos.txt
ALLUVIUM_CONTACT=flo-bit.dev
ALLUVIUM_DENY_COLLECTIONS=app.bsky.*,chat.bsky.*
# The official instance lists every collection on the network; the local one
# adds anything seen live since.
ALLUVIUM_STATUS_URLS=https://jetstream.us-east.bsky.network/status?tab=collections,http://127.0.0.1:8080/status?tab=collections
