backfill.atmo.tools {
	# Export and query service. Exports compress themselves.
	@alluvium path /export /collections /alluvium/* /xrpc/tools.atmo.index.*
	handle @alluvium {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}

	# Everything else is the stock Jetstream v2 API: /subscribe,
	# /xrpc/network.bsky.jetstream.*, /status.
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}
