# Patched Jetstream v2: archives every collection except the denied ones,
# backfilling only the repos listed in repos.txt.
JETSTREAM_ADDR=127.0.0.1:8080
JETSTREAM_DEBUG_ADDR=127.0.0.1:6060
JETSTREAM_RELAY_URL=https://bsky.network
JETSTREAM_PLC_URL=https://plc.directory
JETSTREAM_DATA_DIR=/var/lib/alluvium/jetstream
JETSTREAM_INGEST_DENY_COLLECTIONS=app.bsky.*,chat.bsky.*
JETSTREAM_BACKFILL_REPO_LIST=/var/lib/alluvium/repos.txt
# Shown to the relay and every PDS we download from.
JETSTREAM_USER_AGENT="alluvium-jetstream/0.1 (+https://backfill.atmo.tools; flo-bit.dev)"

# The repo list is re-read on every retry pass.
JETSTREAM_FAILED_REPO_RETRY_INTERVAL=15m
JETSTREAM_FAILED_REPO_RETRY_WORKERS=4
JETSTREAM_FAILED_REPO_RETRY_HOST_WORKERS=4

# Sized for a 4 GB host shared with the export service. The block cache
# must stay well under GOMEMLIMIT or the process spends its time in GC.
GOMEMLIMIT=1800MiB
JETSTREAM_SUBSCRIBE_BLOCK_CACHE_BYTES=268435456
JETSTREAM_SUBSCRIBE_READ_LOG_RETENTION_BYTES=134217728

# A repo is parsed wholly in memory. On a small host, skip repos whose CAR
# is larger than this and keep chain-break resyncs to two at a time.
JETSTREAM_BACKFILL_MAX_REPO_BYTES=268435456
JETSTREAM_VERIFIER_RESYNC_WORKERS=2
