[Unit]
Description=Alluvium export service
After=network-online.target
Wants=network-online.target

[Service]
User=alluvium
Group=alluvium
EnvironmentFile=/etc/alluvium/alluvium.env
Environment=GOMEMLIMIT=300MiB
ExecStart=/opt/alluvium/bin/alluvium serve
Restart=always
RestartSec=5
MemoryHigh=400M
MemoryMax=500M
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
